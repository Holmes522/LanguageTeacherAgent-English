# EngMentor 本地开发环境变量示例
#
# 本文件只包含占位符，不含任何真实值，可以安全提交。
# 真实密钥的唯一合法位置是操作系统的凭据存储（Keychain / Stronghold，由 T012 实现）；
# 严禁写入本文件、.env、数据库、日志、界面状态或 Git（SPEC-M00 §9、AGENTS.md）。
#
# 用法：复制为 .env 后填写自己的值。.env 已被 .gitignore 忽略，禁止提交。

# ---- DeepSeek（主模型网关，M03 实现）----
# base url 与 model id 属于非敏感配置，与"密钥"分开管理。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# API 密钥：此处留空。真实值请通过应用内的设置界面写入 OS 凭据存储。
# 本地临时调试如需填入 .env，用完请清空；不要粘贴到 Issue、聊天记录或截图里。
DEEPSEEK_API_KEY=

# ---- 本地检索（M06 实现）----
# 只记录模型名；权重文件不进入仓库，首次使用时由应用下载并校验哈希（Q7 已确认）。
ENGM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- 数据目录（M02 实现）----
# 留空表示使用系统默认位置（Windows 为 %APPDATA%\EngMentor）。仓库内不得保存运行时数据。
ENGM_DATA_DIR=
