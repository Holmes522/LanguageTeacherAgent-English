{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engmentor.local/contracts/v1/envelope.schema.json",
  "title": "LocalResponse",
  "description": "所有边界上的统一响应信封（SPEC-M00 §5.2 / B-6）。成功与失败两种形态由 ok 判别：成功必须带 data、不得带 error；失败必须带 error、不得带 data。刻意不使用跨文件 $ref —— 三个校验器（TS/Python/Rust）都只编译单份文档，避免多文档引用解析差异成为三方不一致的来源；$defs 中 error 与 citation 的形状与 error.schema.json、citation.schema.json 行为等价，由 packages/contracts/tests/fixtures 的共享正反例同时压两份文档来保证。",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "success": {
      "title": "LocalResponseSuccess",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "requestId",
        "data",
        "citations"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "请求标识，用于日志与故障定位配对。空字符串等同于缺失。"
        },
        "data": true,
        "citations": {
          "type": "array",
          "description": "该回答依据的来源列表。没有依据时必须是空数组，而不是省略字段——省略会让\"无来源\"和\"忘了带\"无法区分。",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      },
      "description": "成功形态。data 的业务结构在 M00 不受约束（§5.2 不定义业务命令字段），因此这里是布尔 schema true：任何 JSON 值都合法，具体形状由各模块的 schema 追加。"
    },
    "failure": {
      "title": "LocalResponseFailure",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "requestId",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "error": {
      "title": "LocalResponseError",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ENGM.CONTRACT.INVALID_INPUT",
            "ENGM.CONTRACT.SCHEMA_INVALID",
            "ENGM.CONTRACT.VERSION_MISMATCH",
            "ENGM.INTERNAL.UNEXPECTED"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {}
      }
    },
    "citation": {
      "title": "LocalResponseCitation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceName",
        "sourceVersion",
        "sourceLocator",
        "licenseLabel"
      ],
      "properties": {
        "sourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceLocator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "licenseLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "usage": {
      "title": "LocalResponseUsage",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "cached"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached": {
          "type": "boolean"
        }
      }
    }
  }
}
