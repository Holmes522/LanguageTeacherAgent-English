{
  "name": "@engm/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "EngMentor 本地契约包：schema/v1 是唯一来源，生成 TypeScript 与 Python 类型，并由 Rust 在运行时按同一份 schema 校验。",
  "main": "src/index.ts",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/check-drift.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
